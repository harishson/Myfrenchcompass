# ── Sanity (Upcoming Batches CMS) ─────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values. See SANITY-SETUP.md.

# From sanity.io/manage → your project → "Project ID"
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Usually "production"
NEXT_PUBLIC_SANITY_DATASET=production

# Pinned API date — leave as-is unless you know why you're changing it
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Any long random string. The SAME value goes in the Sanity webhook "Secret"
# field. Used to verify revalidation requests. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SANITY_REVALIDATE_SECRET=

# The live site URL. Drives the sitemap, robots.txt, canonical tags, Open Graph
# URLs and the JSON-LD. Must match the PRIMARY domain in Vercel exactly — no
# trailing slash, and no "www." unless www is the primary.
NEXT_PUBLIC_SITE_URL=https://myfrenchcompass.com

# ── Contact form email delivery (Web3Forms — free) ───────────────────────────
# Get a free access key: go to web3forms.com, enter myfrenchcompass@gmail.com,
# and paste the key here. Submissions then email straight to that inbox.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
